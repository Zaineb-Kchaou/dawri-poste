@startuml cycle_en_y
title Cycle en Y du projet Dawri
skinparam shadowing false

rectangle "Étude préliminaire\net dépôt GitHub" as ETU

package "Branche fonctionnelle" #E0F2F1 {
  rectangle "Vision et acteurs\n(livrable TP1)" as VIS
  rectangle "Cas d'utilisation UC1 à UC6\npriorisés (livrable TP1)" as UC
}
package "Branche technique" #FBE9E7 {
  rectangle "Exigences techniques\nconcurrence, sécurité, SMS" as EXT
  rectangle "Architecture de base\nroute UC1 (livrable TP1)" as ARC
}

rectangle "FUSION\nConception préliminaire\nclasses et séquence de UC1" as FUS #E1BEE7
rectangle "Conception détaillée" as CD
rectangle "Codage en couches\ncontrôleur, service, données" as COD
rectangle "Tests unitaires et intégration\n(livrable TP1)" as TST
rectangle "Revue croisée\n(livrable TP1)" as REV
rectangle "Recette et transition (v1.0)" as REC

ETU --> VIS
ETU --> EXT
VIS --> UC
EXT --> ARC
UC --> FUS
ARC --> FUS
FUS --> CD
CD --> COD
COD --> TST
TST --> REV
REV --> REC
@enduml
